{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,  // ✅ Helps avoid third-party type issues
    "forceConsistentCasingInFileNames": true,
    "typeRoots": ["./node_modules/@types"],
    //"types": ["node", "express"]
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
